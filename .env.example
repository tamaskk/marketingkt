# Cloudflare R2 — csak szerver oldalon használt, NE legyen NEXT_PUBLIC_ előtag.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Az automatizációk ezzel töltenek fel (Authorization: Bearer <kulcs>).
# Generálás: openssl rand -hex 32
UPLOAD_API_KEY=

# MongoDB Atlas connection string (posztok szövegei)
MONGODB_URI=

# Belépési jelszó a Hub felületéhez (saját, erős jelszó)
HUB_PASSWORD=
